{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sipi.network-tensor.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "parameter_kind", "axis", "port_map", "data", "shape", "complex_encoding", "dtype", "byte_order", "layout", "z0", "wave_definition", "reader", "extensions"],
  "properties": {
    "schema": {"const": "sipi.network-tensor.v1"},
    "parameter_kind": {"enum": ["S", "Y", "Z", "H", "EXT"]},
    "parameter_kind_name": {"type": "string", "minLength": 1},
    "axis": {"$ref": "axis.v1.schema.json"},
    "port_map": {"$ref": "port-map.v1.schema.json"},
    "data": {"$ref": "artifact-ref.v1.schema.json"},
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency", "output_ports", "input_ports"],
      "properties": {
        "frequency": {"type": "integer", "minimum": 1},
        "output_ports": {"type": "integer", "minimum": 1},
        "input_ports": {"type": "integer", "minimum": 1}
      }
    },
    "complex_encoding": {"enum": ["interleaved", "split"]},
    "dtype": {"enum": ["complex128", "complex64", "float64", "float32"]},
    "byte_order": {"enum": ["little", "big"]},
    "layout": {"enum": ["C", "F"]},
    "z0": {"$ref": "#/$defs/z0"},
    "wave_definition": {"enum": ["power", "pseudo", "traveling"]},
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_reader", "reader_semantics", "extensions"],
      "properties": {
        "source_reader": {"type": "string", "minLength": 1},
        "reader_semantics": {"type": "string", "minLength": 1},
        "port_reorder": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1}
            }
          }
        },
        "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
      }
    },
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
  },
  "if": {"properties": {"parameter_kind": {"const": "EXT"}}},
  "then": {"required": ["parameter_kind_name"]},
  "$defs": {
    "z0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "extensions"],
      "properties": {
        "kind": {"enum": ["scalar", "per_frequency", "per_port"]},
        "value": {"type": "number", "exclusiveMinimum": 0},
        "values_artifact": {"$ref": "artifact-ref.v1.schema.json"},
        "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
      }
    }
  }
}
