{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sipi.run-record.v1",
  "type": "object",
  "required": ["schema", "run_id", "analysis_id", "attempt_id", "status", "operation", "payload_schema", "artifacts", "error", "extensions"],
  "properties": {
    "schema": {"const": "sipi.run-record.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed", "cancelled"]},
    "operation": {"enum": ["circuit.solve.v1", "network.fit.v1", "link.simulate.v1", "com.r480.run.v1"]},
    "payload_schema": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"$ref": "artifact-ref.v1.schema.json"}},
    "error": {"anyOf": [{"$ref": "_defs/runtime-validation.v1.schema.json#/$defs/platform_error"}, {"type": "null"}]},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"properties": {"error": {"type": "null"}}}},
    {"if": {"properties": {"status": {"enum": ["failed", "cancelled"]}}}, "then": {"properties": {"error": {"$ref": "_defs/runtime-validation.v1.schema.json#/$defs/platform_error"}}}}
  ],
  "additionalProperties": false
}
