{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"sipi.engine-lock.v1", "type":"object", "additionalProperties":false,
  "required":["schema","engines","operation_defaults","extensions"],
  "properties":{
    "schema":{"const":"sipi.engine-lock.v1"},
    "engines":{"type":"array","items":{"$ref":"#/$defs/engine"}},
    "operation_defaults":{"type":"object","additionalProperties":{"$ref":"run-request.v1.schema.json#/$defs/backend_selection"}},
    "extensions":{"type":"object","propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "path":{"type":"string","pattern":"^(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "file":{"type":"object","additionalProperties":false,"required":["relative_path","role","sha256","byte_length"],"properties":{"relative_path":{"$ref":"#/$defs/path"},"role":{"enum":["entrypoint","library","dependency","data"]},"sha256":{"$ref":"#/$defs/sha256"},"byte_length":{"type":"integer","minimum":0}}},
    "engine":{"type":"object","additionalProperties":false,"required":["instance_id","engine_family","version","source_commit","bundle","protocol","capabilities","runtime","dependency_lock_sha256","license_provenance","bundle_manifest","extensions"],"properties":{
      "instance_id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._-]*$"},"engine_family":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"source_commit":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
      "bundle":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","path","sha256"],"properties":{"kind":{"const":"local_path"},"path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/sha256"}}},{"type":"object","additionalProperties":false,"required":["kind","url","sha256"],"properties":{"kind":{"const":"https_url"},"url":{"type":"string","pattern":"^https://[^?#]+$"},"sha256":{"$ref":"#/$defs/sha256"}}}]},
      "protocol":{"type":"object","additionalProperties":false,"required":["request_schema","result_schema"],"properties":{"request_schema":{"const":"sipi.backend-execution-request.v1"},"result_schema":{"const":"sipi.backend-execution-result.v1"}}},
      "capabilities":{"type":"object","additionalProperties":false,"required":["schema","sha256"],"properties":{"schema":{"const":"sipi.engine-capabilities.v1"},"sha256":{"$ref":"#/$defs/sha256"}}},
      "runtime":{"type":"object","additionalProperties":false,"required":["kind","os","architecture","python_abi","rust_target"],"properties":{"kind":{"enum":["python","native","hybrid"]},"os":{"enum":["windows","linux","macos"]},"architecture":{"type":"string","minLength":1},"python_abi":{"type":["string","null"]},"rust_target":{"type":["string","null"]}}},
      "dependency_lock_sha256":{"$ref":"#/$defs/sha256"},"license_provenance":{"type":"object","additionalProperties":false,"required":["distribution_status","manifest_sha256"],"properties":{"distribution_status":{"enum":["authorized_public","authorized_private","external_reference_only","blocked_unknown"]},"manifest_sha256":{"$ref":"#/$defs/sha256"}}},
      "bundle_manifest":{"type":"object","additionalProperties":false,"required":["entrypoint","files"],"properties":{"entrypoint":{"$ref":"#/$defs/path"},"files":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/file"}}}},"extensions":{"type":"object","propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
    }}
  }
}
