{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sipi.capabilities-certified.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "advertise", "capability_key_fields", "entries", "non_claims"],
  "properties": {
    "schema": {"const": "sipi.capabilities-certified.v1"},
    "status": {"const": "certified"},
    "advertise": {"const": true},
    "capability_key_fields": {
      "const": ["operation", "payload_schema", "engine_instance", "behavior_profile", "platform.os", "platform.architecture", "execution_mode"]
    },
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "non_claims": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation", "payload_schema", "engine_instance", "bundle_hash", "behavior_profile", "platform",
        "execution_mode", "role", "evidence_state", "release_channel", "resource_enforcement", "evidence_refs",
        "certified_at", "expires_at", "limits"
      ],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "payload_schema": {"type": "string", "minLength": 1},
        "engine_instance": {"type": "string", "minLength": 1},
        "bundle_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "behavior_profile": {"type": "string", "minLength": 1},
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture"],
          "properties": {
            "os": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1}
          }
        },
        "execution_mode": {"type": "string", "minLength": 1},
        "role": {"enum": ["reference", "candidate", "hybrid"]},
        "evidence_state": {"const": "certified"},
        "release_channel": {"const": "stable"},
        "resource_enforcement": {"$ref": "_defs/runtime-validation.v1.schema.json#/$defs/resource_enforcement"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "certified_at": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 1},
        "limits": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
      }
    }
  }
}
