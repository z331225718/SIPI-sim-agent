{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sipi.run-result.v1",
  "type": "object",
  "required": ["schema", "run_id", "analysis_id", "attempt_id", "operation", "payload_schema", "status", "selection_requested", "backend_executions", "fallback_trace", "comparison", "metrics_summary", "artifacts", "warnings", "provenance", "timings", "resource_usage", "error", "extensions"],
  "properties": {
    "schema": {"const": "sipi.run-result.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["circuit.solve.v1", "network.fit.v1", "link.simulate.v1", "com.r480.run.v1"]},
    "payload_schema": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed", "cancelled"]},
    "selection_requested": {"$ref": "run-request.v1.schema.json#/$defs/backend_selection"},
    "backend_executions": {"type": "array", "items": {"$ref": "#/$defs/backend_execution_summary"}},
    "fallback_trace": {"type": "array", "items": {"$ref": "#/$defs/fallback_rejection"}},
    "comparison": {"type": "object"},
    "metrics_summary": {"type": "object"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref_slot"}},
    "events": {"type": "array", "items": {"$ref": "run-event.v1.schema.json"}},
    "event_log_artifact": {"$ref": "#/$defs/artifact_ref_slot"},
    "provenance": {"type": "object", "$comment": "M1-04 owns provenance member semantics."},
    "timings": {"type": "object", "$comment": "M1-03 owns timing member semantics."},
    "resource_usage": {"$ref": "_defs/runtime-validation.v1.schema.json#/$defs/resource_usage"},
    "error": {"anyOf": [{"$ref": "_defs/runtime-validation.v1.schema.json#/$defs/platform_error"}, {"type": "null"}]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
  },
  "oneOf": [
    {"required": ["events"], "not": {"required": ["event_log_artifact"]}},
    {"required": ["event_log_artifact"], "not": {"required": ["events"]}}
  ],
  "$defs": {
    "artifact_ref_slot": {"type": "object", "required": ["schema"], "properties": {"schema": {"const": "sipi.artifact-ref.v1"}}, "additionalProperties": true},
    "fallback_rejection": {"type": "object", "required": ["instance", "reason"], "properties": {"instance": {"type": "string", "minLength": 1}, "reason": {"enum": ["EngineUnavailable", "UnsupportedCapability"]}}},
    "backend_execution_summary": {
      "type": "object",
      "required": ["backend_execution_id", "role", "engine_instance_id", "bundle_hash", "status", "domain_result_schema", "artifacts", "error"],
      "properties": {"backend_execution_id": {"type": "string", "minLength": 1}, "role": {"enum": ["primary", "reference", "candidate"]}, "engine_instance_id": {"type": "string", "minLength": 1}, "bundle_hash": {"type": "string", "minLength": 1}, "status": {"enum": ["succeeded", "failed", "cancelled"]}, "domain_result_schema": {"type": ["string", "null"]}, "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref_slot"}}, "error": {"anyOf": [{"$ref": "_defs/runtime-validation.v1.schema.json#/$defs/platform_error"}, {"type": "null"}]}}
    }
  }
}
