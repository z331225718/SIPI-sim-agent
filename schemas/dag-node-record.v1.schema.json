{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sipi.dag-node-record.v1",
  "type": "object",
  "required": ["schema", "run_id", "analysis_id", "status", "blocked_by", "extensions"],
  "properties": {
    "schema": {"const": "sipi.dag-node-record.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "minLength": 1},
    "status": {"const": "blocked"},
    "blocked_by": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["analysis_id", "terminal_status"],
        "properties": {
          "analysis_id": {"type": "string", "minLength": 1},
          "terminal_status": {"enum": ["failed", "cancelled", "blocked"]}
        },
        "additionalProperties": false
      }
    },
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
  },
  "additionalProperties": false
}
