{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sipi.transform-policy.v1",
  "$comment": "Explicit transform policy (M4-09). Each transform keeps its implementation name; the platform only pins the contract and public semantic fields. Format parsing and algorithm details remain with the domain owner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reader_semantics", "transforms", "extensions"],
  "properties": {
    "schema": {"const": "sipi.transform-policy.v1"},
    "reader_semantics": {"type": "string", "minLength": 1},
    "transforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "parameters", "extensions"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$"
          },
          "kind": {"enum": ["port", "interpolation", "dc", "causality", "passivity"]},
          "parameters": {
            "type": "object",
            "properties": {
              "operation": {"enum": ["identity", "reorder", "polarity", "mixed_mode", "reference"]},
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "method": {"type": "string", "minLength": 1},
              "fft_size": {"type": "integer", "minimum": 2},
              "sample_interval_s": {"type": "number", "exclusiveMinimum": 0},
              "extrapolate": {"type": "boolean"},
              "enforce": {"type": "boolean"},
              "tolerance": {"type": "number", "minimum": 0}
            },
            "additionalProperties": true
          },
          "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
        }
      }
    },
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
  }
}
