{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sipi.waveform.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "axis", "port_map", "signal_kind", "unit", "data", "shape", "channels", "extensions"],
  "properties": {
    "schema": {"const": "sipi.waveform.v1"},
    "axis": {"$ref": "axis.v1.schema.json"},
    "port_map": {"$ref": "port-map.v1.schema.json"},
    "signal_kind": {"enum": ["voltage", "current"]},
    "voltage_measurement": {"enum": ["single_ended", "differential", "open_circuit", "loaded"]},
    "current_sign_convention": {"enum": ["into_positive_terminal", "out_of_positive_terminal"]},
    "unit": {"type": "string", "minLength": 1},
    "data": {"$ref": "artifact-ref.v1.schema.json"},
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "channels"],
      "properties": {
        "samples": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1}
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/channel"}
    },
    "sample_scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "offset"],
      "properties": {
        "scale": {"type": "number"},
        "offset": {"type": "number"}
      }
    },
    "effective_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_index", "end_index"],
      "properties": {
        "start_index": {"type": "integer", "minimum": 0},
        "end_index": {"type": "integer", "minimum": 1}
      }
    },
    "warmup_samples": {"type": "integer", "minimum": 0},
    "trimming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leading_samples", "trailing_samples"],
      "properties": {
        "leading_samples": {"type": "integer", "minimum": 0},
        "trailing_samples": {"type": "integer", "minimum": 0}
      }
    },
    "initial_state": {"type": "string", "minLength": 1},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port_id", "signal_intent", "polarity", "extensions"],
      "properties": {
        "port_id": {"type": "string", "minLength": 1},
        "signal_intent": {"enum": ["voltage", "current"]},
        "polarity": {"enum": [1, -1]},
        "reference": {"type": "string", "minLength": 1},
        "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
      }
    }
  }
}
