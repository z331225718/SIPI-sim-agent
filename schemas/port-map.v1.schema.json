{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sipi.port-map.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "basis", "index_base", "ports", "extensions"],
  "properties": {
    "schema": {"const": "sipi.port-map.v1"},
    "basis": {"enum": ["single_ended", "mixed_mode"]},
    "index_base": {"enum": [0, 1]},
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/port"}
    },
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "external_index", "kind", "polarity", "extensions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
        "label": {"type": "string", "minLength": 1},
        "external_index": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["signal", "common_mode", "reference"]},
        "polarity": {"enum": [1, -1]},
        "pair_with": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+$"}}
      }
    }
  }
}
