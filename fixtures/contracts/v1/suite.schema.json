{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Test-only conformance manifest; it is not a public SIPI contract schema.",
  "type": "object",
  "required": ["suite", "version", "status", "coverage", "cases"],
  "properties": {
    "suite": {"const": "sipi.contract-conformance.v1"},
    "version": {"const": 1},
    "status": {"enum": ["incremental_partial", "complete"]},
    "coverage": {"type": "object", "required": ["implemented_layers", "not_covered"], "properties": {"implemented_layers": {"type": "object"}, "not_covered": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "entrypoint", "mode", "expect", "required_languages", "origin"],
      "oneOf": [
        {"required": ["schema_id", "path"], "not": {"anyOf": [{"required": ["external_contract"]}, {"required": ["probe"]}]}, "properties": {"runner": {"const": "local"}, "origin": {"properties": {"kind": {"const": "synthetic_contract"}}}}},
        {"required": ["external_contract", "runner", "probe"], "not": {"anyOf": [{"required": ["schema_id"]}, {"required": ["path"]}]}, "properties": {"runner": {"const": "pybert_core_rust"}, "external_contract": {"oneOf": [{"const": {"kind": "wire_schema_id", "value": "pybert.simulation.v1"}}, {"const": {"kind": "embedded_type", "value": "PyBERT RunEventV1"}}]}, "origin": {"properties": {"kind": {"const": "authoritative_external"}}}}},
        {"required": ["external_contract", "runner", "probe"], "not": {"anyOf": [{"required": ["schema_id"]}, {"required": ["path"]}]}, "properties": {"runner": {"const": "agent_com_python"}, "external_contract": {"const": {"kind": "embedded_type", "value": "agent-com ProgressEvent"}}, "origin": {"properties": {"kind": {"const": "authoritative_external"}}}}}
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
        "schema_id": {"type": "string", "minLength": 1},
        "external_contract": {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"enum": ["wire_schema_id", "embedded_type", "legacy_document"]}, "value": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "runner": {"enum": ["local", "pybert_core_rust", "agent_com_python"]},
        "probe": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "mode": {"enum": ["producer", "consumer"]},
        "path": {"type": "string", "pattern": "^cases/[a-z0-9.-]+/[a-z0-9.-]+$"},
        "expect": {"type": "object", "required": ["decision", "phase"], "properties": {"decision": {"enum": ["accept", "reject"]}, "phase": {"enum": ["json", "schema", "semantic", "relation", "integrity"]}, "code": {"type": "string", "minLength": 1}, "preserve": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
        "required_languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["python", "rust"]}},
        "origin": {"type": "object", "required": ["kind", "source_ref"], "properties": {"kind": {"enum": ["synthetic_contract", "authoritative_external"]}, "source_ref": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "deferred_to": {"type": "string", "enum": ["M1-07", "M1-08"]}
      },
      "additionalProperties": false
    }
  }
}
