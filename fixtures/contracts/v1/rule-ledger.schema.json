{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Test-only M1-06 authority coverage ledger; it is not a public SIPI contract schema.",
  "type": "object",
  "required": ["schema", "scope", "authority_sha256", "rules"],
  "properties": {
    "schema": {"const": "sipi.conformance-rule-ledger.v1"},
    "scope": {"type": "object", "required": ["task", "authority_path"], "properties": {"task": {"const": "M1-06"}, "authority_path": {"const": "schemas/authority.v1.yaml"}}, "additionalProperties": false},
    "authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {"type": "object", "required": ["id", "schema_id", "obligation", "layer", "evidence"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"}, "schema_id": {"type": "string", "minLength": 1}, "obligation": {"enum": ["producer", "consumer"]}, "layer": {"enum": ["schema", "semantic", "relation", "integrity", "preservation"]}, "evidence": {"type": "object", "minProperties": 1, "properties": {"python": {"$ref": "#/$defs/evidence"}, "rust": {"$ref": "#/$defs/evidence"}}, "additionalProperties": false}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["state", "implementation_refs", "case_refs"], "properties": {"state": {"enum": ["covered", "gap", "deferred", "not_applicable"]}, "implementation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "case_refs": {"type": "array", "items": {"type": "object", "required": ["id", "document"], "properties": {"id": {"type": "string", "minLength": 1}, "document": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "deferred_to": {"enum": ["M1-07", "M1-08"]}}, "additionalProperties": false}
  }
}
