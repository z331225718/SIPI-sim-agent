{
  "schema": "sipi.project.v1",
  "project": {"name": "rfm-to-link", "extensions": {}},
  "runtime": {"engine_lock": "engine.lock", "extensions": {}},
  "analyses": [
    {
      "id": "rfm-response",
      "operation": "circuit.solve.v1",
      "backend_selection": {"mode": "strict", "instance": "agent-spice-process"},
      "payload_schema": "sipi.adapter.agent-spice.rfm-response-request.v1",
      "payload": {"rfm": "models/channel.rfm", "fft_size": 32768, "dt": 1e-12},
      "static_inputs": {"rfm": "models/channel.rfm"},
      "exports": [{"role": "rfm-response", "schema": "agent-spice.rfm-response.v1"}]
    },
    {
      "id": "link-eye",
      "operation": "link.simulate.v1",
      "backend_selection": {"mode": "strict", "instance": "pybert-python"},
      "payload_schema": "pybert.simulation.v1",
      "payload": {"simulation_input": {
        "schema": "pybert.simulation.v1",
        "runId": "sipi-rfm-to-link",
        "modulation": "nrz",
        "pattern": {"kind": "prbs", "order": 7, "seed": 17},
        "timebase": {"sampleInterval": 1.0e-12, "samplesPerUi": 2, "dataRate": 500.0e9, "nbits": 16},
        "channel": {"kind": "impulse_response", "value": {"sampleInterval": 1.0e-12, "impulseResponseVoltsPerSecond": [1.0e12, 0.25e12], "sourceImpedance": 50.0, "loadImpedance": 50.0}},
        "tx": {"amplitude": 0.5, "ffe": {"enabled": false, "weights": [], "cursorPosition": 0}},
        "rx": {"nativeCtleEnabled": false, "dfeTaps": 0, "viterbiEnabled": false},
        "analysis": {"statisticalEye": null, "includeJitter": false, "includeBathtub": false},
        "limits": {"maxTotalSamples": 50000000, "maxMemoryBytes": 2147483648, "maxDistributionStates": 200000},
        "externalModels": [],
        "legacyOptions": {}
      }},
      "depends_on": ["rfm-response"],
      "inputs": {
        "channel": {
          "from_analysis": "rfm-response",
          "artifact_role": "rfm-response",
          "expected_schema": "agent-spice.rfm-response.v1"
        }
      }
    }
  ],
  "extensions": {}
}
