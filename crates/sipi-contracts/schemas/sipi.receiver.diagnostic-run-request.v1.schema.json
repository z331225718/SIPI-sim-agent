{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"WireReceiverDiagnosticRunRequestV1","description":"Product-owned request for the fixed, diagnostic-only receiver stage.\n\nThe profile, waveform shape, reference bits, and frontend are all explicit.\nIt deliberately carries no RFM, S-parameter, file, URL, or external-engine\nprovenance.","type":"object","properties":{"input":{"$ref":"#/$defs/WireReceiverInputV1"},"profile_id":{"type":"string"},"reference_bits":{"type":"array","items":{"type":"boolean"}},"schema":{"type":"string"}},"additionalProperties":false,"required":["schema","profile_id","input","reference_bits"],"$defs":{"WireCtleStageV1":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"bypass"}},"additionalProperties":false,"required":["kind"]}]},"WireFfeStageV1":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"bypass"}},"additionalProperties":false,"required":["kind"]}]},"WireReceiverInputV1":{"description":"Product-owned receiver waveform boundary for the required RFM profile.\n\nThe external RFM/current-drive provenance deliberately does not cross this\nboundary. DFE, CDR, and BER are not represented because their semantics\nremain explicitly unselected.","type":"object","properties":{"frontend":{"$ref":"#/$defs/WireRxStagesV1"},"receive_volts":{"type":"array","items":{"type":"number","format":"double"}},"samples_per_ui":{"type":"integer","format":"uint","minimum":0},"schema":{"type":"string"},"timebase":{"$ref":"#/$defs/WireUniformTimebaseV1"}},"additionalProperties":false,"required":["schema","timebase","receive_volts","samples_per_ui","frontend"]},"WireRxStagesV1":{"type":"object","properties":{"ctle":{"$ref":"#/$defs/WireCtleStageV1"},"ffe":{"$ref":"#/$defs/WireFfeStageV1"}},"additionalProperties":false,"required":["ctle","ffe"]},"WireUniformTimebaseV1":{"type":"object","properties":{"sample_count":{"type":"integer","format":"uint","minimum":0},"sample_interval_seconds":{"type":"number","format":"double"},"start_seconds":{"type":"number","format":"double"}},"additionalProperties":false,"required":["start_seconds","sample_interval_seconds","sample_count"]}}}
