{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"WireIbisQuasiStaticArtifactEvaluateRequestV1","description":"A sealed-artifact variant of the selected Input/TYP quasi-static request.\nThe IBIS text itself never crosses stdin; the caller binds one exact\npublished `model.ibs` payload through its artifact and manifest identities.","type":"object","properties":{"artifact":{"$ref":"#/$defs/WireSealedArtifactIdentityV1"},"probe":{"$ref":"#/$defs/WireIbisQuasiStaticProbeV1"},"schema":{"type":"string"},"selection":{"$ref":"#/$defs/WireIbisDcSelectionV1"}},"additionalProperties":false,"required":["schema","artifact","selection","probe"],"$defs":{"WireIbisDcSelectionV1":{"type":"object","properties":{"corner":{"type":"string"},"ibis_version":{"type":"string"},"model_selector":{"type":"string"}},"additionalProperties":false,"required":["ibis_version","model_selector","corner"]},"WireIbisQuasiStaticProbeV1":{"type":"object","properties":{"gnd_clamp_drive_volts":{"type":"number","format":"double"},"power_clamp_drive_volts":{"type":"number","format":"double"},"sig_to_ref_slope_volts_per_second":{"type":"number","format":"double"}},"additionalProperties":false,"required":["gnd_clamp_drive_volts","power_clamp_drive_volts","sig_to_ref_slope_volts_per_second"]},"WireSealedArtifactIdentityV1":{"type":"object","properties":{"artifact_id":{"type":"string"},"manifest_sha256":{"type":"string"}},"additionalProperties":false,"required":["artifact_id","manifest_sha256"]}}}
